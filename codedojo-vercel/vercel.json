{
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:action", "destination": "/api/handler?action=:action" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
